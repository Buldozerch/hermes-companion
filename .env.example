# Copy this file to .env and keep real credentials out of version control.
# Fixture for examples/remote_vps.rs; the desktop app does not read it.
# Target: a disposable Ubuntu 24.04 LTS VPS with systemd and root/passwordless sudo.
# Installation tests will update packages, create a user and install a service.

HERMES_TEST_HOST=
HERMES_TEST_PORT=22
HERMES_TEST_USERNAME=root

# Choose one authentication method: password OR an absolute private key file path.
# Quote values containing spaces, # characters or other dotenv special characters.
HERMES_TEST_PASSWORD=
HERMES_TEST_PRIVATE_KEY_PATH=
HERMES_TEST_KEY_PASSPHRASE=

# Optional at initial setup: SHA256 host fingerprint from the provider's console.
HERMES_TEST_HOST_FINGERPRINT=

# Optional now; required later to verify a real response from the model provider.
HERMES_TEST_MODEL_PROVIDER=openrouter
HERMES_TEST_MODEL=
HERMES_TEST_MODEL_API_KEY=
